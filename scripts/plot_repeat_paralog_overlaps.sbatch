#!/bin/bash
#SBATCH --job-name=paralog_overlaps
#SBATCH --output=logs/paralog_overlaps_%j.log
#SBATCH --error=logs/paralog_overlaps_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00

# ==============================================================================
# SCRIPT NAME: generate_paralog_overlaps.sh
#
# Malin Pinsky, September 2026, with Gemini assistance
#
# DESCRIPTION:
#   Quantifies and visualizes multi-set genomic overlaps between repeat-masked 
#   regions (generated by the nf-trim-generode pipeline) and paralog filter 
#   BED tracks (e.g., High Depth, Excess Heterozygosity, and NGSParalog DupHMM) from the
#   nf-paralog pipeline.
#
# WORKFLOW STEPS:
#   1. Parses and sorts input genomic region BED files.
#   2. Computes multi-track base-pair intersections using `bedtools multiinter`.
#   3. Aggregates total overlapping base pairs per filter combination.
#   4. Renders a publication-ready UpSet plot PNG using an integrated R script.
#
# INPUT REQUIREMENTS:
#   - Repeat/CpG Mask BED:   <params.outdir>/data/reference/*.combined_mask.bed
#   - High Depth BED:       ./filters/high_depth.bed
#   - Excess Het BED:       ./filters/excess_het.bed
#   - NGSParalog DupHMM BED: nf-pipelines/nf-paralog/results/paralogs/ngsparalog_duphmm_regions.bed
#
# OUTPUTS:
#   - output/paralogs/paralog_filter_overlaps.png : UpSet plot displaying genomic overlap (bp)
#   - logs/paralog_overlaps_%j.log/.err : SLURM stdout and stderr logs
#
# SOFTWARE DEPENDENCIES:
#   - bedtools (v2.29+)
#   - R (v4.0+)
#
# USAGE:
#   sbatch run_paralog_overlaps.sh
# ==============================================================================

set -e

# ==============================================================================
# 1. USER CONFIGURATION & ENVIRONMENT SETUP
# ==============================================================================
# Load HPC modules or activate environment
module load container_env bedtools/2.31.0 R/4.2.1

# Pipeline output directory containing repeat mask output
RESULTS_DIR="nf-pipelines/nf-trim-generode/results-iridian"

# Automatically locate Nextflow pipeline repeat mask output
REPEAT_BED=$(find "${RESULTS_DIR}/data/reference" -maxdepth 1 -name "*.combined_mask.bed" 2>/dev/null | head -n 1)

# Paths to your other paralog filter BED files
HIGH_DEPTH_BED="nf-pipelines/nf-paralog/results/angsd/high_depth_regions.bed"
EXCESS_HET_BED="nf-pipelines/nf-paralog/results/angsd/hwe_excess_het.bed"

# Path to NGSParalog DupHMM regions BED file
NGSPARALOG_BED="nf-pipelines/nf-paralog/results/paralogs/ngsparalog_duphmm_regions.bed"

OUTPUT_PLOT="output/paralogs/repeats_paralog_overlaps.png"
TEMP_DIR=$(mktemp -d -p .)

# Verify input files exist
echo "[INFO] Using RepeatMasker BED: ${REPEAT_BED}"
for f in "${REPEAT_BED}" "${HIGH_DEPTH_BED}" "${EXCESS_HET_BED}" "${NGSPARALOG_BED}"; do
    if [ ! -f "$f" ]; then
        echo "[ERROR] Required BED file not found: $f"
        exit 1
    fi
done

# ------------------------------------------------------------------------------
# 2. SANITIZE, SORT BED FILES, AND COMPUTE INTERSECTIONS (BEDTOOLS)
# ------------------------------------------------------------------------------
echo "[INFO] Sanitizing and sorting BED files..."

# Helper function to remove headers/non-integer coordinates and sort
clean_and_sort() {
    awk 'BEGIN{OFS="\t"} $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {print $1, $2, $3}' "$1" | sort -k1,1 -k2,2n
}

clean_and_sort "${REPEAT_BED}"     > "${TEMP_DIR}/sorted_repeat.bed"
clean_and_sort "${HIGH_DEPTH_BED}" > "${TEMP_DIR}/sorted_depth.bed"
clean_and_sort "${EXCESS_HET_BED}" > "${TEMP_DIR}/sorted_het.bed"

# Clean and sort NGSParalog DupHMM BED file
clean_and_sort "${NGSPARALOG_BED}" > "${TEMP_DIR}/sorted_ngsparalog.bed"

echo "[INFO] Computing genomic overlaps with bedtools multiinter..."
crun.bedtools bedtools multiinter \
  -i "${TEMP_DIR}/sorted_repeat.bed" \
     "${TEMP_DIR}/sorted_depth.bed" \
     "${TEMP_DIR}/sorted_het.bed" \
     "${TEMP_DIR}/sorted_ngsparalog.bed" \
  -names RepeatMasker HighDepth ExcessHet NGSParalog_DupHMM \
  > "${TEMP_DIR}/multiinter.bed"

echo "[INFO] Aggregating base-pair counts per filter combination..."
awk 'BEGIN{FS="\t"; OFS="\t"} NR>0 && $4>0 {
    bp = $3 - $2;
    gsub(/,/, " + ", $5);
    sum[$5] += bp;
} END {
    for (comb in sum) {
        print comb, sum[comb];
    }
}' "${TEMP_DIR}/multiinter.bed" > "${TEMP_DIR}/overlap_counts.tsv"

# ------------------------------------------------------------------------------
# 3. GENERATE OVERLAP PLOT USING BASE R (NO PACKAGES NEEDED)
# ------------------------------------------------------------------------------
echo "[INFO] Rendering plot with Base R graphics..."
crun.R Rscript - "${TEMP_DIR}/overlap_counts.tsv" "${OUTPUT_PLOT}" << 'EOF'
options(bitmapType = "cairo")

args <- commandArgs(trailingOnly = TRUE)
counts_file <- args[1]
output_png  <- args[2]

# Load aggregated data
df <- read.table(counts_file, header = FALSE, sep = "\t", stringsAsFactors = FALSE)
colnames(df) <- c("combination", "bp")

# Convert base pairs to Megabases (Mb)
df$mb <- df$bp / 1e6

# Sort by size ascending (so largest bars appear at top of horizontal plot)
df <- df[order(df$mb), ]

# Configure dynamic PNG height based on number of combinations
plot_height <- max(5, nrow(df) * 0.45)
png(output_png, width = 10, height = plot_height, units = "in", res = 300, type = "cairo")

# Set left margin to prevent filter combination labels from clipping
par(mar = c(5, 25, 4, 4), family = "sans")

# Draw horizontal barplot
bars <- barplot(
  df$mb,
  names.arg = df$combination,
  horiz = TRUE,
  las = 1,                # Horizontal y-axis labels
  col = "#2b5c8f",
  border = NA,
  xlab = "Overlapping Region Size (Mb)",
  main = "Genomic Overlap Across Paralog Filters",
  cex.names = 0.85,
  cex.axis = 0.9,
  xlim = c(0, max(df$mb) * 1.18)
)

# Add exact Mb values at the end of each bar
text(
  x = df$mb,
  y = bars,
  labels = sprintf("  %.2f Mb", df$mb),
  pos = 4,
  xpd = TRUE,
  cex = 0.8,
  col = "#333333"
)

grid(nx = NULL, ny = NA, col = "lightgray", lty = "dotted")
dev.off()

cat(paste0("[SUCCESS] Saved overlap plot to ", output_png, "\n"))
EOF

# Clean up temp directory
rm -rf "${TEMP_DIR}"
echo "[INFO] Pipeline run completed."