profiles {

    // --- Wahab HPC Profile ---
    wahab {
        conda.enabled       = true
        singularity.enabled = true
        singularity.autoMounts = true

        process {
            executor = 'slurm'
            queue    = 'main'
            conda    = "environments/nf-angsd-selection.yml"

            // Default profile resources
            cpus   = 8
            memory = '32 GB'

            // Specific task overrides
            withName: 'ANGSD_GL_ALL|ANGSD_COLLECT_OUTPUT|PCANGSD|ANGSD_GL_POP' {
                cpus   = 8
                memory = '16 GB'
            }

            withName: 'COLLECT_BAM_ALL|COLLECT_BAM_POP' {
                executor = 'local'
                cpus     = 1
                memory   = '4 GB'
                conda    = null
            }

            // Heavy SFS and FST matrix generation
            withName: 'ANGSD_DIVERSITY|ANGSD_FST' {
                    cpus   = 16
                    memory = '32 GB'
            }

            // Per-contig LD pruning
            withName: 'LD_PRUNE_CONTIG' {
                cpus   = 8
                memory = '16 GB'
            }

            // Wahab module & crun wrappers
            withName: 'ANGSD_GL_ALL|QC_POP_SITES|CALC_POP_THRESHOLDS' {
                module = ['container_env', 'samtools/1.19']
                beforeScript = '''
                    mkdir -p .bin
                    echo -e '#!/bin/bash\nexec crun.samtools samtools "$@"' > .bin/samtools
                    chmod +x .bin/samtools
                    export PATH="$(pwd)/.bin:$PATH"
                '''
            }

            withName: 'INDEX_BED_SITES|ANGSD_DIVERSITY|LD_PRUNE_CONTIG' {
                module = ['container_env', 'ngsTools']
                beforeScript = '''
                    mkdir -p .bin
                    for tool in ngsFST ngsStat ngsPopGen ngsDist ngsSim ngs2dsfs ngsLD prune_graph; do
                        echo -e "#!/bin/bash\nexec crun.ngsTools $tool "'"$@"' > .bin/$tool
                        chmod +x .bin/$tool
                    done
                    export PATH="$(pwd)/.bin:$PATH"
                '''
            }

            withName: 'RUN_ACER|ANGSD_FST|PLOT_PI_DIVERSITY' {
                module = ['container_env', 'R']
                beforeScript = '''
                    mkdir -p .bin
                    echo -e '#!/bin/bash\nexec crun.R Rscript "$@"' > .bin/Rscript
                    echo -e '#!/bin/bash\nexec crun.R R "$@"' > .bin/R
                    chmod +x .bin/Rscript .bin/R
                    export PATH="$(pwd)/.bin:$PATH"
                '''
            }
        }
    }

    // --- Wahab Test Profile ---
    testwahab {
        conda.enabled       = true
        singularity.enabled = true
        singularity.autoMounts = true

        process {
            executor = 'slurm'
            queue    = 'main'
            conda    = "environments/nf-angsd-selection.yml"

            // Low resources for fast testing
            cpus   = 1
            memory = '4 GB'

            withName: 'COLLECT_BAM_ALL|COLLECT_BAM_POP' {
                executor = 'local'
                cpus     = 1
                memory   = '4 GB'
                conda    = null
            }

            // Wahab module & crun wrappers
            withName: 'ANGSD_GL_ALL|QC_POP_SITES|CALC_POP_THRESHOLDS' {
                module = ['container_env', 'samtools/1.19']
                beforeScript = '''
                    mkdir -p .bin
                    echo -e '#!/bin/bash\nexec crun.samtools samtools "$@"' > .bin/samtools
                    chmod +x .bin/samtools
                    export PATH="$(pwd)/.bin:$PATH"
                '''
            }

            withName: 'INDEX_BED_SITES|ANGSD_DIVERSITY|LD_PRUNE_CONTIG' {
                module = ['container_env', 'ngsTools']
                beforeScript = '''
                    mkdir -p .bin
                    for tool in ngsFST ngsStat ngsPopGen ngsDist ngsSim ngs2dsfs ngsLD prune_graph; do
                        echo -e "#!/bin/bash\nexec crun.ngsTools $tool "'"$@"' > .bin/$tool
                        chmod +x .bin/$tool
                    done
                    export PATH="$(pwd)/.bin:$PATH"
                '''
            }

            withName: 'RUN_ACER|ANGSD_FST|PLOT_PI_DIVERSITY' {
                module = ['container_env', 'R']
                beforeScript = '''
                    mkdir -p .bin
                    echo -e '#!/bin/bash\nexec crun.R Rscript "$@"' > .bin/Rscript
                    echo -e '#!/bin/bash\nexec crun.R R "$@"' > .bin/R
                    chmod +x .bin/Rscript .bin/R
                    export PATH="$(pwd)/.bin:$PATH"
                '''
            }
        }
    }
}