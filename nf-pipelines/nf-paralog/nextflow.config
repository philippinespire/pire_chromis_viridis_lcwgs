// Malin Pinsky, 2026
// With the assistance of GPT5.3 and Google Gemini (August 2026).

profiles {
    wahab {
        conda.enabled = true
        singularity.enabled = true
        singularity.autoMounts = true

        process {
            executor = 'slurm'
            queue = 'main'
            conda = "${projectDir}/environment.yml"
            
            withName: 'FASTP.*' { cpus = 4; memory = '8 GB' }
            withName: 'BWA.*' { cpus = 8; memory = '16 GB' }
            withName: 'MARKDUP.*' { cpus = 2; memory = '8 GB' }
            withName: 'MERGE_BAMS' { cpus = 4; memory = '8 GB' }
            
            // GATK 3.7 Configuration
            withName: 'INDEL_REALN' {
                container = '/cm/shared/containers/docker/broadinstitute-gatk3:3.7-0.sif'
                conda = null // Disable conda for this specific process
                cpus = 4
                memory = '16 GB'
            }
            withName: 'INDEX_REALIGNED' {
                cpus   = 2
                memory = '4 GB'
            }
            withName: 'ANGSD_HWE_DEPTH' {
                cpus   = 8
                memory = '32 GB'
            }
            withName: 'GENERATE_CONTIG_BEDS' {
                cpus   = 1
                memory = '2 GB'
            }
            withName: 'NGSPARALOG_CALCLR' {
                cpus   = 2
                memory = '16 GB'
            }
            withName: 'COMBINE_PARALOGS' {
                cpus   = 1
                memory = '4 GB'
            }
            withName: 'CALCULATE_AVG_DEPTH' {
                cpus   = 4
                memory = '8 GB'
            }
            withName: 'DUPHMM_TRAIN' {
                beforeScript = 'module load container_env R; export R_LIBS_USER=~/.R/library' // load the R module and make local packages available (need truncnorm and docopt)
                ext.rscript  = 'crun Rscript' // set up how Rscript needs to be called on wahab. Used by DUPHMM_* processes
                cpus   = 2
                memory = '8 GB'
            }
            withName: 'SPLIT_SCAFFOLDS' {
                cpus   = 2
                memory = '8 GB'
            }
            withName: 'DUPHMM_INFER' {
                beforeScript = 'module load container_env R; export R_LIBS_USER=~/.R/library' // load the R module and make local packages available (need truncnorm and docopt)
                ext.rscript  = 'crun Rscript' // set up how Rscript needs to be called on wahab. Used by DUPHMM_* processes
                cpus     = 4
                memory   = '48 GB'
                maxForks = 200 // Prevents overloading SLURM scheduler queue
            }
            withName: 'COMBINE_DUPHMM' {
                cpus   = 1
                memory = '4 GB'
            }
            withName: 'PLOT_PARALOG_LR|PLOT_ANGSD_DEPTH|PLOT_ANGSD_HWE|PLOT_FILTER_OVERLAPS|PLOT_ALLELE_BALANCE' {
                beforeScript = 'module load container_env R; export R_LIBS_USER=~/.R/library' // load the R module and make local packages available (probably not needed for plotting)
                ext.rscript  = 'crun Rscript' // set up how Rscript needs to be called on wahab
                cpus   = 2
                memory = '16 GB'
            }
        }
    }
}