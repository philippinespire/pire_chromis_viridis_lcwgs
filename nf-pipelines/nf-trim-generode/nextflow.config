// Marianne Dehasque and Malin Pinsky, 2026
// Pipeline optimization, dynamic channel routing (DSL2), and logic structuring 
// were developed with the assistance of GPT5.3 and Google Gemini (July 2026).


profiles {
    standard {
        conda.enabled = true
        singularity.enabled = true
        singularity.autoMounts = true
        process {
            executor = 'slurm'
            queue = 'main'
            conda = "${projectDir}/environment.yml"
            
            withName: 'FASTP.*' { cpus = 2; memory = '8 GB' }
            withName: 'SEQTK.*' { cpus = 1; memory = '4 GB' }
            withName: 'SPLIT.*' { cpus = 1; memory = '4 GB' }
            withName: 'QC.*' { cpus = 2; memory = '4 GB' }
            withName: 'BWA.*' { cpus = 4; memory = '16 GB' }
            withName: 'MARKDUP.*' { cpus = 2; memory = '8 GB' }
            withName: 'MERGE_BAMS' { cpus = 2; memory = '8 GB' }
            withName: 'AMBER_PREP' { cpus = 2; memory = '8 GB' }
            withName: 'AMBER' { cpus = 2; memory = '8 GB' }
            withName: 'BAM_QC' { cpus = 2; memory = '8 GB' }
            withName: 'INDEX_REALIGNED' { cpus = 2; memory = '8 GB' }
            withName: 'PREP_REFERENCE_REPEAT' { cpus = 1; memory = '4 GB' }
            withName: 'CALC_HISTORICAL_TRIMLEN_BAM' { cpus = 1; memory = '4 GB' }
            
            // GATK 3.7 Configuration
            withName: 'INDEL_REALN' {
                container = '/cm/shared/containers/docker/broadinstitute-gatk3:3.7-0.sif'
                conda = null // Disable conda for this specific process
                cpus = 4
                memory = '16 GB'
            }
            withName: 'REPEAT_MODELER' {
                container = '/cm/shared/containers/docker/quay.io-biocontainers-repeatmodeler:2.0.1--pl526_0.sif'
                conda = null // Disable conda for this specific process

                // Set a reasonable high baseline
                cpus   = 16
                memory = { 128.GB * task.attempt } // Multiplies memory on retry
                time   = { 48.h  * task.attempt }
        
                // Error handling strategy for Out-of-Memory crashes
                errorStrategy = { task.exitStatus in [137, 140, 255] ? 'retry' : 'terminate' }
                maxRetries = 2
            }
            
            withName: 'REPEAT_MASKER' {
                container = '/cm/shared/containers/docker/quay.io-biocontainers-repeatmasker:4.0.9_p2--pl526_2.sif'
                // RepeatMasker inherently try to update or rebuild its internal master database cache the first time it runs. 
                // Because Apptainer mounts container image file systems as strictly read-only, RepeatMasker is blocked from writing that cache file to its own /usr/local/ installation path, causing a crash.
                // This tells Apptainer to mount a small, temporary, in-memory file system over the container's root directories. 
                // When RepeatMasker tries to write RepeatMaskerLib.embl into the /usr/local/... folder, Apptainer catches it and safely writes it to RAM instead.
                containerOptions = '--writable-tmpfs' 
                conda = null // Disable conda for this specific process
                cpus = 4
                memory = '8 GB'
            }
        }
    }
}